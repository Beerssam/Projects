+void CDMRGateway::processScanRewrite(CDMRData& data)
+{
+	// Rewrite the destination TG of network->MMDVM traffic to the currently
+	// tuned TX TG so MMDVM_Bridge's export filter (exportTG=0, "follow the
+	// tuned TG") forwards scan traffic to Analog_Bridge. This makes TGIF
+	// 777-style scan TGs audible: the network returns traffic on other TGs
+	// (e.g. 4006282) while the user is tuned to the scan TG (e.g. 4000777).
+	// The TX path (MMDVM->network) is untouched.
+	if (data.getFLCO() != FLCO_GROUP)
+		return;
+
+	unsigned int slotNo = data.getSlotNo();
+	if (slotNo < 1U || slotNo > 2U)
+		return;
+
+	unsigned int tunedTG = m_scanTunedTG[slotNo];
+	if (tunedTG == 0U)
+		return;  // No TX seen yet on this slot, pass through unchanged.
+
+	unsigned int dstId = data.getDstId();
+	if (dstId == tunedTG)
+		return;  // Already matches, nothing to do.
+
+	LogMessage("Scan rewrite: TG %u -> %u (slot %u)", dstId, tunedTG, slotNo);
+
+	// 1:1 rewrite via the standard machinery so the embedded LC is updated
+	// as well as the DMRD header destination.
+	CRewriteTG rewrite("Scan", slotNo, dstId, slotNo, tunedTG, 1U);
+	rewrite.process(data, false);
+}
