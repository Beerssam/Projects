--- a/MMDVMNetwork.cpp
+++ b/MMDVMNetwork.cpp
@@ -291,6 +291,48 @@
 		}
 
 		m_socket.write((unsigned char*)"DMRP", 4U, m_rptAddr, m_rptAddrLen);
+	} else if (::memcmp(m_buffer, "RPTL", 4U) == 0) {
+		// Direct-mode login used by DVSwitch MMDVM_Bridge, which has no
+		// Type=Gateway option. Emulate the network side of the handshake.
+		m_id = (m_buffer[4U] << 24) | (m_buffer[5U] << 16) | (m_buffer[6U] << 8) | (m_buffer[7U] << 0);
+
+		LogMessage("MMDVM, RPTL login from %u, accepting", m_id);
+
+		// RPTACK + 4-byte salt; the following RPTK is accepted without
+		// verification (local loopback, DMRGateway has no local password).
+		unsigned char ack[10U];
+		::memcpy(ack + 0U, "RPTACK", 6U);
+		ack[6U] = 0x12U;
+		ack[7U] = 0x34U;
+		ack[8U] = 0x56U;
+		ack[9U] = 0x78U;
+		m_socket.write(ack, 10U, m_rptAddr, m_rptAddrLen);
+	} else if (::memcmp(m_buffer, "RPTK", 4U) == 0) {
+		unsigned char ack[6U];
+		::memcpy(ack + 0U, "RPTACK", 6U);
+		m_socket.write(ack, 6U, m_rptAddr, m_rptAddrLen);
+	} else if (::memcmp(m_buffer, "RPTC", 4U) == 0) {
+		// Repeater configuration, stored like the DMRC config so the
+		// "Waiting for MMDVM to connect" gate in DMRGateway::run is satisfied.
+		m_id = (m_buffer[4U] << 24) | (m_buffer[5U] << 16) | (m_buffer[6U] << 8) | (m_buffer[7U] << 0);
+
+		if (m_configData == NULL) {
+			m_configLen = length - 8U;
+			m_configData = new unsigned char[m_configLen];
+			::memcpy(m_configData, m_buffer + 8U, m_configLen);
+		}
+
+		unsigned char ack[6U];
+		::memcpy(ack + 0U, "RPTACK", 6U);
+		m_socket.write(ack, 6U, m_rptAddr, m_rptAddrLen);
+	} else if (::memcmp(m_buffer, "RPTO", 4U) == 0) {
+		unsigned char ack[6U];
+		::memcpy(ack + 0U, "RPTACK", 6U);
+		m_socket.write(ack, 6U, m_rptAddr, m_rptAddrLen);
+	} else if (::memcmp(m_buffer, "RPTPING", 7U) == 0) {
+		m_socket.write((unsigned char*)"MSTPONG", 7U, m_rptAddr, m_rptAddrLen);
+	} else if (::memcmp(m_buffer, "RPTCL", 5U) == 0) {
+		LogMessage("MMDVM, RPTCL logout from %u", m_id);
 	} else {
 		CUtils::dump("Unknown packet from the MMDVM", m_buffer, length);
 	}
