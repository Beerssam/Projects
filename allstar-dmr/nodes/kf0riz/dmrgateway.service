[Unit]
Description=DMRGateway multi-mode DMR (KF0RIZ)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/DMRGateway /opt/DMRGateway/DMRGateway.ini
Restart=on-failure
RestartSec=5
; DMRGateway logs to stdout/stderr; view with:
;   sudo journalctl -u dmrgateway -f

[Install]
WantedBy=multi-user.target
