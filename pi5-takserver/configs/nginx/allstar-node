map $http_upgrade $huc_root_backend {
    websocket https://192.168.1.203:8443;
    default http://192.168.1.203:80;
}

server {
    listen 80;
    server_name 625730.nodes.allstarlink.org;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name 625730.nodes.allstarlink.org;

    ssl_certificate /etc/letsencrypt/live/625730.nodes.allstarlink.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/625730.nodes.allstarlink.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /dashboard {
        return 301 https://$host/dashboard/;
    }

    location /dashboard/ {
        proxy_pass https://192.168.1.203:9090;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
    }

    location = /modeswitch {
        return 301 https://$host/modeswitch/;
    }

    location /modeswitch/ {
        proxy_pass http://192.168.1.203:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $huc_root_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
    }
    include /etc/nginx/huc-location.conf;
}
